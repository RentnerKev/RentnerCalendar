{
    "$schema": "./node_modules/oxfmt/configuration_schema.json",
    "semi": false,
    "singleQuote": true,
    "trailingComma": "all",
    "tabWidth": 4,
    "useTabs": false,
    "printWidth": 80,
    "sortPackageJson": false,
    "ignorePatterns": [
        "dist/",
        "build/",
        "node_modules/",
        "bun.lock",
        "drizzle/**",
        "**/drizzle/**",
        ".env",
        "**/.env",
        "**/.env.*",
        "playground/dist/**",
        "playground/node_modules/**",
        "test-results/**",
        "playwright-report/**",
        "**/routeTree.gen.*",
        "**/bindings/**",
        "target/**"
    ]
}
