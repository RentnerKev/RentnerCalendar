{
    "name": "@rentnerkev/calendar",
    "version": "2.6.0",
    "description": "A customizable React calendar with range selection, time input, holidays, and fast navigation.",
    "author": "RentnerKev",
    "license": "MIT",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "type": "module",
    "files": [
        "dist",
        "tailwind.css",
        "README.md",
        "docs/usage.md"
    ],
    "sideEffects": [
        "./tailwind.css"
    ],
    "scripts": {
        "build": "bun -e \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true })\" && tsc",
        "test": "bun test",
        "typecheck": "tsc --noEmit && tsc --project tsconfig.type-tests.json && tsc --project playground/tsconfig.json --noEmit && bun run typecheck:automation",
        "prepare": "bun run build",
        "pack:check": "bun pm pack --dry-run",
        "pack:consumer": "node scripts/consumer/verify.mjs",
        "test:e2e": "playwright test",
        "playground:dev": "bun --cwd playground dev",
        "playground:build": "bun --cwd playground build",
        "lint": "oxlint --deny-warnings src scripts playground/src playwright.config.ts .github/scripts",
        "lint:fix": "oxlint --fix --deny-warnings src scripts playground/src playwright.config.ts .github/scripts",
        "format": "oxfmt src scripts playground README.md docs package.json tailwind.css tsconfig.json tsconfig.type-tests.json playwright.config.ts .oxlintrc.json .oxfmtrc.json bunfig.toml .github",
        "format:check": "oxfmt --check src scripts playground README.md docs package.json tailwind.css tsconfig.json tsconfig.type-tests.json playwright.config.ts .oxlintrc.json .oxfmtrc.json bunfig.toml .github",
        "verify": "bun run typecheck && bun run lint && bun run format:check && bun run test && bun run build && bun run pack:check && bun run pack:consumer && bun run test:e2e",
        "typecheck:automation": "tsc --noEmit -p .github/scripts/tsconfig.json"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/RentnerKev/RentnerCalendar.git"
    },
    "homepage": "https://packages.rentner.dev/packages/calendar",
    "bugs": {
        "url": "https://github.com/RentnerKev/RentnerCalendar/issues"
    },
    "publishConfig": {
        "access": "public",
        "registry": "https://registry.npmjs.org"
    },
    "peerDependencies": {
        "react": "^19.0.0",
        "react-dom": "^19.0.0"
    },
    "devDependencies": {
        "@axe-core/playwright": "^4.13.0",
        "@playwright/test": "^1.63.0",
        "@types/bun": "^1.4.2",
        "@types/node": "^26.6.4",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "oxfmt": "^0.72.0",
        "oxlint": "^1.87.0",
        "react": "^19.3.0",
        "react-dom": "^19.3.0",
        "typescript": "^7.0.2"
    },
    "dependencies": {
        "@radix-ui/react-select": "^2.3.8",
        "@rentnerkev/tooltips": "^2.0.8",
        "lucide-react": "^1.52.0"
    },
    "exports": {
        ".": {
            "import": "./dist/index.js",
            "types": "./dist/index.d.ts"
        },
        "./tailwind.css": "./tailwind.css",
        "./calendar": {
            "import": "./dist/shared/Calendar/Components/Calendar.js",
            "types": "./dist/shared/Calendar/Components/Calendar.d.ts"
        },
        "./single-calendar": {
            "import": "./dist/shared/Calendar/Components/SingleCalendar.js",
            "types": "./dist/shared/Calendar/Components/SingleCalendar.d.ts"
        },
        "./range-calendar": {
            "import": "./dist/shared/Calendar/Components/RangeCalendar.js",
            "types": "./dist/shared/Calendar/Components/RangeCalendar.d.ts"
        },
        "./value": {
            "import": "./dist/lib/Calendar/CalendarValue.js",
            "types": "./dist/lib/Calendar/CalendarValue.d.ts"
        },
        "./format": {
            "import": "./dist/lib/Calendar/FormatFunctions.js",
            "types": "./dist/lib/Calendar/FormatFunctions.d.ts"
        },
        "./date": {
            "import": "./dist/lib/Calendar/date.js",
            "types": "./dist/lib/Calendar/date.d.ts"
        },
        "./messages": {
            "import": "./dist/lib/Calendar/messages.js",
            "types": "./dist/lib/Calendar/messages.d.ts"
        },
        "./types": {
            "import": "./dist/types.js",
            "types": "./dist/types.d.ts"
        },
        "./package.json": "./package.json",
        "./ai": {
            "types": "./dist/ai.d.ts",
            "import": "./dist/ai.js"
        }
    },
    "packageManager": "bun@1.4.2"
}
