{
    "name": "@rentnerkev/calendar",
    "version": "1.0.0",
    "description": "A customizable React calendar with range selection, time input, holidays, and fast navigation.",
    "author": "RentnerKev",
    "license": "MIT",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "type": "module",
    "files": [
        "dist"
    ],
    "sideEffects": false,
    "scripts": {
        "build": "bun -e \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true })\" && tsc",
        "typecheck": "tsc --noEmit",
        "prepare": "bun run build",
        "pack:check": "bun pm pack --dry-run",
        "playground:dev": "bun --cwd playground dev",
        "playground:build": "bun --cwd playground build",
        "lint": "oxlint .",
        "lint:fix": "oxlint --fix .",
        "format": "oxfmt .",
        "format:check": "oxfmt --check .",
        "verify": "bun run typecheck && bun run lint && bun run format:check && bun run build && bun run pack:check"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/RentnerKev/RentnerCalendar.git"
    },
    "homepage": "https://github.com/RentnerKev/RentnerCalendar#readme",
    "bugs": {
        "url": "https://github.com/RentnerKev/RentnerCalendar/issues"
    },
    "publishConfig": {
        "access": "public",
        "registry": "https://registry.npmjs.org"
    },
    "peerDependencies": {
        "react": "^19.2.8",
        "react-dom": "^19.2.8"
    },
    "devDependencies": {
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.2.4",
        "react": "^19.3.0",
        "react-dom": "^19.3.0",
        "typescript": "^7.0.2",
        "oxfmt": "^0.66.0",
        "oxlint": "^1.79.0"
    },
    "dependencies": {
        "@radix-ui/react-select": "^2.3.7",
        "@radix-ui/react-tooltip": "^1.2.16",
        "lucide-react": "^1.33.0"
    },
    "exports": {
        ".": {
            "import": "./dist/index.js",
            "types": "./dist/index.d.ts"
        },
        "./calendar": {
            "import": "./dist/Calendar.js",
            "types": "./dist/Calendar.d.ts"
        },
        "./format": {
            "import": "./dist/Tools/FormatFunctions.js",
            "types": "./dist/Tools/FormatFunctions.d.ts"
        },
        "./types": {
            "import": "./dist/types.js",
            "types": "./dist/types.d.ts"
        }
    },
    "packageManager": "bun@1.4.2"
}
